# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EVOLINK_API_KEY: Required for EvoLink image generation.
# Configure this via the Secrets panel in the AI Studio UI.
EVOLINK_API_KEY="MY_EVOLINK_API_KEY"

# EVOLINK_IMAGE_MODEL: Model ID from EvoLink (e.g. qwen-image-3.0-pro).
# IMPORTANT: This must be a model ID, NEVER your API key (do NOT put sk-... here).
EVOLINK_IMAGE_MODEL="qwen-image-3.0-pro"

# MESHY_API_KEY: Required for Meshy Multi-Image-to-3D reconstruction.
# Set via Secrets or server environment. Never exposed to client.
MESHY_API_KEY=""

# MESHY_3D_MODEL: Model version for Meshy 3D (default: meshy-7.1)
MESHY_3D_MODEL="meshy-7.1"

# ENABLE_LIVE_3D_RECONSTRUCTION: Safety feature flag to enable real paid calls (default: false)
ENABLE_LIVE_3D_RECONSTRUCTION="false"

# LIVE_3D_TESTS & LIVE_3D_MAX_CALLS: Smoke testing limiters
LIVE_3D_TESTS="0"
LIVE_3D_MAX_CALLS="1"
